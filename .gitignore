# ROS2 build files
/build/
/install/
/log/   
# Python cache files
__pycache__/
*.pyc       
# IDE specific files
.vscode/
.idea/
*.iml
# Temporary files   
*.tmp
*.swp
*~

# Runtime/local launch state
src/config/last_launch_config.json

# Isaac Sim world assets are local-only. They are large and should not be pushed.
src/worlds/
src/worlds/*.usd
src/worlds/*.usda
src/worlds/*.usdc
src/worlds/*.usd.bak

# Local Isaac assets copied next to helper packages should not be pushed.
seg_vis/*.usd
